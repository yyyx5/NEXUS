[
  {
    "name": "nexus_save",
    "description": "保存当前用户原话对应的1..10个提议，一次事务。第一项必须通用record，额外人物/事件/转述可批量添加。身份和source由服务器绑定，不能传source或路径。pending_source尚未保存。 成功返回user_confirmation和receipts；向用户说明实际保存档案/分类/财务明细状态，原话兜底不冒充结构化完成。",
    "parameters": {
      "type": "object",
      "properties": {
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "record",
                  "entity",
                  "event",
                  "claim"
                ]
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "domain": {
                "type": "string",
                "enum": [
                  "life",
                  "work",
                  "health",
                  "unclassified"
                ],
                "description": "仅四类；冥想/感悟/碎碎念/旅行属于life，health默认受限，不确定用unclassified。"
              },
              "quote": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              },
              "payload": {
                "type": "object"
              },
              "assertion_kind": {
                "type": "string",
                "enum": [
                  "user_report",
                  "third_party_report",
                  "user_judgment",
                  "user_feeling",
                  "ai_inference",
                  "unconfirmed",
                  "plan"
                ]
              },
              "certainty": {
                "type": "string",
                "enum": [
                  "stated",
                  "uncertain",
                  "unknown",
                  "retracted"
                ]
              },
              "perspective": {
                "type": "string",
                "enum": [
                  "user",
                  "third_party",
                  "ai"
                ]
              },
              "temporal_status": {
                "type": "string",
                "enum": [
                  "occurred",
                  "planned",
                  "unknown"
                ]
              },
              "valid_from": {
                "type": "string"
              },
              "valid_to": {
                "type": "string"
              },
              "time_expression": {
                "type": "string"
              },
              "time_precision": {
                "type": "string",
                "enum": [
                  "unknown",
                  "year",
                  "month",
                  "day",
                  "instant",
                  "range"
                ]
              },
              "timezone": {
                "type": "string"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "private",
                  "restricted"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "review",
                  "deleted"
                ]
              },
              "task": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "done",
                      "cancelled",
                      "paused"
                    ]
                  },
                  "due_date": {
                    "type": "string"
                  },
                  "due_expression": {
                    "type": "string"
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              },
              "financial": {
                "type": "object",
                "properties": {
                  "amount_minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "CNY",
                      "USD",
                      "EUR",
                      "HKD",
                      "GBP",
                      "JPY"
                    ]
                  },
                  "scale": {
                    "type": "integer"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "expense",
                      "income",
                      "refund"
                    ]
                  },
                  "entry_class": {
                    "type": "string",
                    "enum": [
                      "booked",
                      "quote",
                      "budget",
                      "commitment"
                    ]
                  },
                  "occurred_date": {
                    "type": "string"
                  }
                },
                "required": [
                  "amount_minor",
                  "currency",
                  "direction"
                ],
                "additionalProperties": false
              },
              "schedule": {
                "type": "object",
                "properties": {
                  "start_date": {
                    "type": "string"
                  },
                  "end_date": {
                    "type": "string"
                  },
                  "time_expression": {
                    "type": "string"
                  }
                },
                "required": [
                  "time_expression"
                ],
                "additionalProperties": false
              },
              "group_id": {
                "type": "string",
                "description": "固定档案编号。明确指定或内容吻合的当前档案才可关联；空字符串仅用于明确移出。"
              },
              "group_name": {
                "type": "string",
                "description": "用户原话中的档案名称；同名有歧义则待归组。"
              },
              "group_relevance": {
                "type": "string",
                "enum": [
                  "context"
                ],
                "description": "仅内容属于当前档案且domain吻合时使用。"
              },
              "group_profile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "start_date": {
                    "type": "string"
                  },
                  "end_date": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "context_action": {
                "type": "string",
                "enum": [
                  "activate",
                  "clear"
                ],
                "description": "仅档案卡可用，用户明确要求设为当前/结束时使用，24小时过期。"
              },
              "summary_for_group": {
                "type": "string",
                "description": "用户明确要求档案汇总时使用固定group_id；服务生成带版本清单的费用快照，不能同时财务入账/关联成员。"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "proposals"
      ],
      "additionalProperties": false
    }
  },
